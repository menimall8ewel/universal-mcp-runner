{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "universal-mcp-runner",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "UniversalMcpAgent",
        "class_name": "UniversalMcpAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "think-v1",
      "new_sqlite_classes": ["UniversalMcpAgent"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
